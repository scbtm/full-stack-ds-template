from {{ package_name }}.modeling.functions import (
    load_features,
    prepare_train_test_split,
    train_model,
    evaluate_model,
    save_model
)
from {{ package_name }}.config import config


def train_and_evaluate_model():
    """
    Complete model training step: load data, train, evaluate, and save model.

    Returns:
        Training results with metrics and model path.
    """
    print("Starting model training step...")

    # Load processed features
    features = load_features(config.features_path)
    print(f"Loaded features with shape: {features.shape}")

    # Prepare train/test split
    X_train, X_test, y_train, y_test = prepare_train_test_split(
        features,
        target_column=config.modeling.target_column,
        test_size=config.modeling.test_size,
    )
    
    print(f"Train set: {X_train.shape}, Test set: {X_test.shape}")

    # Train model
    model = train_model(X_train, y_train)
    print("Model training completed")

    # Evaluate model
    metrics = evaluate_model(model, X_test, y_test)
    print(f"Model accuracy: {metrics['accuracy']:.3f}")

    return {
        'metrics': metrics,
        'train_size': len(X_train),
        'test_size': len(X_test)
    }


def validate_model_performance(metrics_threshold: float = 0.5):
    """
    Validate that model performance meets minimum requirements.

    Args:
        metrics_threshold: Minimum accuracy threshold.

    Returns:
        Validation results.
    """
    print("Validating model performance...")

    # Load features and train a quick model for validation
    features = load_features(config.features_path)
    X_train, X_test, y_train, y_test = prepare_train_test_split(features)

    model = train_model(X_train, y_train)
    metrics = evaluate_model(model, X_test, y_test)

    accuracy = metrics['accuracy']
    performance_valid = accuracy >= metrics_threshold

    validation_results = {
        'performance_valid': performance_valid,
        'accuracy': accuracy,
        'threshold': metrics_threshold
    }

    if performance_valid:
        print(f"Model performance validation passed: {accuracy:.3f} >= {metrics_threshold}")
    else:
        print(f"Model performance validation failed: {accuracy:.3f} < {metrics_threshold}")

    return validation_results