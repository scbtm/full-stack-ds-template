from {{ package_name }}.monitoring.functions import (
    load_reference_data,
    load_current_data,
    detect_drift,
    log_monitoring_results
)
from {{ package_name }}.config import config
from typing import Dict, Any


def run_drift_detection(drift_threshold: float = 0.5):
    """
    Complete drift detection step: load data, detect drift, and log results.

    Args:
        drift_threshold: Threshold for drift alerting.

    Returns:
        Drift detection results.
    """
    print("Starting drift detection step...")

    # Load reference data (training data characteristics)
    reference_data = load_reference_data(config.features_path)
    print(f"Loaded reference data with shape: {reference_data.shape}")

    # Load current production data
    # TODO(template): Configure path for current production data
    current_data_path = config.features_path  # Placeholder
    current_data = load_current_data(current_data_path)
    print(f"Loaded current data with shape: {current_data.shape}")

    # Detect drift
    drift_results = detect_drift(reference_data, current_data, threshold=drift_threshold)

    # Log results
    log_monitoring_results(drift_results)

    return drift_results


def setup_monitoring_alerts(drift_results: Dict[str, Any]):
    """
    Set up alerts based on drift detection results.

    Args:
        drift_results: Results from drift detection.

    Returns:
        Alert configuration.
    """
    print("Setting up monitoring alerts...")

    if drift_results['drift_detected']:
        print("⚠️  DRIFT DETECTED - Setting up alerts")

        # TODO(template): Implement actual alerting (email, Slack, monitoring systems)
        alert_config = {
            'alert_triggered': True,
            'alert_type': 'drift_detected',
            'timestamp': drift_results['timestamp'],
            'affected_features': [
                feature for feature, metrics in drift_results['feature_drifts'].items()
                if metrics['drift_score'] > drift_results['threshold']
            ]
        }
    else:
        print("✅ No drift detected - No alerts needed")
        alert_config = {
            'alert_triggered': False,
            'timestamp': drift_results['timestamp']
        }

    return alert_config


def generate_monitoring_report(drift_results: Dict[str, Any]):
    """
    Generate comprehensive monitoring report.

    Args:
        drift_results: Results from drift detection.

    Returns:
        Report data.
    """
    print("Generating monitoring report...")

    # Calculate summary statistics
    feature_drifts = drift_results['feature_drifts']
    max_drift_score = max([metrics['drift_score'] for metrics in feature_drifts.values()])
    avg_drift_score = sum([metrics['drift_score'] for metrics in feature_drifts.values()]) / len(feature_drifts)

    report = {
        'timestamp': drift_results['timestamp'],
        'drift_detected': drift_results['drift_detected'],
        'total_features_monitored': len(feature_drifts),
        'max_drift_score': max_drift_score,
        'avg_drift_score': avg_drift_score,
        'threshold': drift_results['threshold'],
        'feature_details': feature_drifts
    }

    print(f"Report generated: {len(feature_drifts)} features monitored")
    print(f"Max drift score: {max_drift_score:.3f}, Avg: {avg_drift_score:.3f}")

    # TODO(template): Save report to storage or send to monitoring dashboard

    return report