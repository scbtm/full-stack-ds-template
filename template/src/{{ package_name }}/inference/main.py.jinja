# FastAPI app for serving model predictions.

import uvicorn
from fastapi import FastAPI
from pydantic import BaseModel
from typing import List, Any

app = FastAPI(
    title="{{ project_slug }} Inference API",
    description="API for serving predictions from the trained model.",
    version="0.1.0",
)


class PredictionRequest(BaseModel):
    """Request model for predictions."""
    instances: List[List[float]]


class PredictionResponse(BaseModel):
    """Response model for predictions."""
    predictions: List[Any]


@app.get("/", tags=["Health Check"])
def read_root():
    """Root endpoint for health checks."""
    return {"status": "API is running"}


@app.post("/predict", response_model=PredictionResponse, tags=["Prediction"])
def predict(request: PredictionRequest):
    """
    Endpoint to make predictions.

    Args:
        request: The prediction request containing instances to predict on.

    Returns:
        Predictions for the provided instances.
    """
    # TODO(template): Implement your prediction logic here
    # For now, return empty predictions for each instance
    predictions = [0.0] * len(request.instances)
    return PredictionResponse(predictions=predictions)


def run():
    """Function to run the Uvicorn server."""
    uvicorn.run(app, host="0.0.0.0", port=8080)