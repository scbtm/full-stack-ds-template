# Metaflow pipeline for data collection orchestration.

from metaflow import FlowSpec, step

from {{ package_name }}.data_collection.steps import (
    collect_and_validate_data,
)


class DataCollectionFlow(FlowSpec):
    """Metaflow pipeline for orchestrating data collection tasks."""

    @step
    def start(self):
        """Initialize the data collection flow."""
        print("Starting data collection flow...")
        self.next(self.collect_data)

    @step
    def collect_data(self):
        """Execute data collection and validation."""
        self.data_path = collect_and_validate_data()
        print(f"Data collection completed: {self.data_path}")
        self.next(self.end)

    @step
    def end(self):
        """Complete the data collection flow."""
        print("Data collection flow finished successfully.")
        print(f"Final output: {self.data_path}")

if __name__ == "__main__":
    """Entry point for the data collection flow."""
    DataCollectionFlow()