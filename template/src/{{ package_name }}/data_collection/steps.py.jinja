def collect_and_validate_data():
    """
    Complete data collection step: load, validate, and save data.

    Returns:
        Path to saved data.
    """
    print("Starting data collection step...")

    # Load sample data
    data = load_sample_data()
    print(f"Loaded {len(data)} rows of data")

    # Validate data quality
    if not validate_data_quality(data):
        raise ValueError("Data failed quality validation")

    # Save the data
    output_path = save_raw_data(data)
    print(f"Data collection completed. Saved to: {output_path}")

    return output_path


