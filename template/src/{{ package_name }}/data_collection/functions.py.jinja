def validate_data_quality(data: pd.DataFrame) -> bool:
    """
    Perform basic data quality checks.

    Args:
        data: DataFrame to validate.

    Returns:
        True if data passes quality checks.
    """
    # TODO(template): Implement your data quality checks
    if data.empty:
        return False

    # Check for minimum number of rows
    if len(data) < 1:
        return False

    print(f"Data quality check passed: {len(data)} rows, {len(data.columns)} columns")
    return True