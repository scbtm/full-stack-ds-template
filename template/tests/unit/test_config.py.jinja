from {{ package_name }}.config import AppConfig


def test_app_config_path_construction():
    """Tests if the derived paths are constructed correctly."""
    cfg = AppConfig(base_data_path="/tmp/data", base_artifact_path="/tmp/artifacts")

    assert cfg.raw_data_path == "/tmp/data/raw_data.csv"
    assert cfg.features_path == "/tmp/data/features.parquet"
    assert cfg.model_path == "/tmp/artifacts/model.pkl"


def test_app_config_creation():
    """Test that AppConfig can be created."""
    config = AppConfig()
    assert config is not None