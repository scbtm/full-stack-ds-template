# TEMPLATE PLACEHOLDER:
# Makefile with common developer workflows.
# TODO(template): customize targets for your team.

.PHONY: install format lint typecheck test security-check verify pre-commit ci-verify collect-data{% if include_feature_engineering %} build-features{% endif %} train-model{% if include_monitoring %} monitor-model{% endif %}

# --- Installation ---
install:
	uv sync --all-groups

# --- Quality & Verification ---
format:
	uv run ruff format src tests

lint:
	uv run ruff check --fix src tests

typecheck:
	uv run pyright

test:
	uv run pytest --cov=src --cov-report=html --cov-report=term-missing

security-check:
	uv run pip-audit --local --skip-editable -v

verify: format lint typecheck test security-check

pre-commit: format lint typecheck

ci-verify: format lint typecheck test security-check

# --- Pipeline Execution ---
collect-data:
	uv run collect-data run

{% if include_feature_engineering -%}
build-features:
	uv run build-features run

{% endif -%}
train-model:
	uv run train-model run

{% if include_monitoring -%}
monitor-model:
	uv run monitor-model run
{% endif -%}