# TEMPLATE PLACEHOLDER:
# Cloud Build pipeline that builds, pushes, and deploys to Cloud Run.
# TODO(template): wire Secret Manager for _WANDB_KEY and other secrets.

steps:
  # 1) Build unified image
  - name: 'gcr.io/cloud-builders/docker'
    id: Build
    args:
      - 'build'
      - '-t'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_REPO_NAME}/${_SERVICE_NAME}:latest'
      - '.'

  # 2) Push to Artifact Registry
  - name: 'gcr.io/cloud-builders/docker'
    id: Push
    args:
      - 'push'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_REPO_NAME}/${_SERVICE_NAME}:latest'

{% if api_framework == "fastapi" -%}
  # 3) Deploy API as Cloud Run service
  - name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    id: DeployApi
    entrypoint: gcloud
    args:
      - 'run'
      - 'deploy'
      - '${_SERVICE_NAME}-api'
      - '--image=${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_REPO_NAME}/${_SERVICE_NAME}:latest'
      - '--region=${_REGION}'
      - '--platform=managed'
      - '--allow-unauthenticated'
      - '--set-env-vars=ENTRYPOINT_COMMAND=api'
      - '--quiet'

{% endif -%}
  # 4) Deploy Training as Cloud Run job
  - name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    id: DeployTrainJob
    entrypoint: gcloud
    args:
      - 'run'
      - 'jobs'
      - 'deploy'
      - '${_SERVICE_NAME}-train'
      - '--image=${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_REPO_NAME}/${_SERVICE_NAME}:latest'
      - '--region=${_REGION}'
      - '--set-env-vars=ENTRYPOINT_COMMAND=train-model,BASE_DATA_PATH=gs://${_BUCKET_NAME}/data,WANDB_KEY=${_WANDB_KEY}'
      - '--quiet'

images:
  - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_REPO_NAME}/${_SERVICE_NAME}:latest'

substitutions:
  _REGION: 'us-central1'
  _REPO_NAME: '{{ project_slug }}'
  _SERVICE_NAME: '{{ project_slug }}'
  _BUCKET_NAME: '{{ project_slug }}-bucket'
  _WANDB_KEY: ''

options:
  logging: CLOUD_LOGGING_ONLY