name: CI

on:
  pull_request:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up Python {{ python_version }}
        uses: actions/setup-python@v5
        with:
          python-version: '{{ python_version }}'

      - name: Install uv
        run: pip install uv

      - name: Install Dependencies
        run: make install

      - name: Run Verification
        run: make ci-verify