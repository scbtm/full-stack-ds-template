#!/bin/bash
set -e

# TEMPLATE PLACEHOLDER:
# Entry point that dispatches to API or pipelines based on ENTRYPOINT_COMMAND.
# TODO(template): extend with more commands if needed.

COMMAND=${ENTRYPOINT_COMMAND:-"api"}
echo "Executing command: $COMMAND"

case "$COMMAND" in
  api)
    echo "Starting FastAPI server..."
    exec uv run gunicorn -w 4 -k uvicorn.workers.UvicornWorker {{ package_name }}.inference.main:app -b 0.0.0.0:8080
    ;;
  train-model)
    echo "Running model training pipeline..."
    exec uv run train-model run
    ;;
  build-features)
    echo "Running feature engineering pipeline..."
    exec uv run build-features run
    ;;
  collect-data)
    echo "Running data collection pipeline..."
    exec uv run collect-data run
    ;;
  monitor-model)
    echo "Running model monitoring pipeline..."
    exec uv run monitor-model run
    ;;
  *)
    echo "Error: Unknown command '$COMMAND'"
    echo "Available commands: api, train-model, build-features, collect-data, monitor-model"
    exit 1
    ;;
esac