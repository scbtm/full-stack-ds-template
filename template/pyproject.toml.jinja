[project]
name = "{{ package_name }}"
version = "0.1.0"
description = "A new MLOps project created from the template."
readme = "README.md"
requires-python = ">={{ python_version }}"
dependencies = [
{% if api_framework == "fastapi" -%}
    "fastapi>=0.110.0",
    "gunicorn>=21.2.0",
    "uvicorn[standard]>=0.27.1",
{% endif -%}
    "gcsfs>=2023.12.2",
    "metaflow==2.11.5",
    "pandas>=2.2.0",
    "polars>=0.20.10",
    "pyarrow>=15.0.0",
    "pydantic>=2.6.1",
    "scikit-learn>=1.4.0",
{% if include_feature_engineering -%}
    "sf-hamilton[visualization]>=1.40.0",
{% endif -%}
    "wandb>=0.16.3",
]

[build-system]
requires = ["uv_build>=0.8.13,<0.9.0"]
build-backend = "uv_build"

[tool.dependency-groups]
test = [
    "coverage[toml]>=7.4.1",
{% if api_framework == "fastapi" -%}
    "httpx>=0.26.0",
{% endif -%}
    "pytest>=8.0.0",
    "pytest-cov>=4.1.0",
]
lint = ["ruff>=0.2.1"]
typing = ["pyright>=1.1.348"]
dev = [
    "ipython>=8.21.0",
    "pre-commit>=3.6.0",
    "pip-audit>=2.7.3",
]

[project.scripts]
{% if api_framework == "fastapi" -%}
api = "{{ package_name }}.inference.main:run"
{% endif -%}
collect-data = "{{ package_name }}.data_collection.flow:main"
{% if include_feature_engineering -%}
build-features = "{{ package_name }}.feature_engineering.flow:main"
{% endif -%}
train-model = "{{ package_name }}.modeling.flow:main"
{% if include_monitoring -%}
monitor-model = "{{ package_name }}.monitoring.flow:main"
{% endif -%}

[tool.pytest.ini_options]
markers = [
    "slow: marks tests as slow (deselect with '-m \"not slow\"')",
]

[tool.ruff]
line-length = 88
indent-width = 4

[tool.ruff.lint]
select = ["E4", "E7", "E9", "F", "I"]